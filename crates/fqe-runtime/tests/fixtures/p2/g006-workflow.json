                "version": 1,
                "shape": "scalar",
                "kind": "u64"
              },
              "value": "3"
            },
            "constraints": {},
            "description": "Closed bars strictly after arming event"
          }
        ]
      },
      "inputs": [
        {
          "name": "cross",
          "type": {
            "version": 1,
            "shape": "scalar",
            "kind": "bool"
          }
        },
        {
          "name": "rsi_ok",
          "type": {
            "version": 1,
            "shape": "scalar",
            "kind": "bool"
          }
        }
      ],
      "state": [
        {
          "name": "remaining",
          "type": {
            "version": 1,
            "shape": "scalar",
            "kind": "u64"
          },
          "initial": {
            "type": {
              "version": 1,
              "shape": "scalar",
              "kind": "u64"
            },
            "value": "0"
          }
        },
        {
          "name": "latched",
          "type": {
            "version": 1,
            "shape": "scalar",
            "kind": "bool"
          },
          "initial": {
            "type": {
              "version": 1,
              "shape": "scalar",
              "kind": "bool"
            },
            "value": false
          }
        }
      ],
      "delays": [],
      "modes": [
        "idle",
        "armed"
      ],
      "initial_mode": "idle",
      "transitions": [
        {
          "id": "arm",
          "from": [
            "idle"
          ],
          "to": "armed",
          "guard": {
            "input": "input.cross"
          },
          "writes": {
            "remaining": {
              "parameter": "wait"
            },
            "latched": {
              "literal": {
                "type": {
                  "version": 1,
                  "shape": "scalar",
                  "kind": "bool"
                },
                "value": false
              }
            }
          }
        },
        {
          "id": "advance",
          "from": [
            "armed"
          ],
          "to": null,
          "guard": {
            "binary": {
              "op": "greater",
              "left": {
                "input": "state.remaining"
              },
              "right": {
                "literal": {
                  "type": {
                    "version": 1,
                    "shape": "scalar",
                    "kind": "u64"
                  },
                  "value": "1"
                }
              }
            }
          },
          "writes": {
            "remaining": {
              "binary": {
                "op": "subtract",
                "left": {
                  "input": "state.remaining"
                },
                "right": {
                  "literal": {
                    "type": {
                      "version": 1,
                      "shape": "scalar",
                      "kind": "u64"
                    },
                    "value": "1"
                  }
                }
              }
            },
            "latched": {
              "binary": {
                "op": "or",
                "left": {
                  "input": "state.latched"
                },
                "right": {
                  "input": "input.rsi_ok"
                }
              }
            }
          }
        },
        {
          "id": "expire",
          "from": [
            "armed"
          ],
          "to": "idle",
          "guard": {
            "binary": {
              "op": "equal",
              "left": {
                "input": "state.remaining"
              },
              "right": {
                "literal": {
                  "type": {
                    "version": 1,
                    "shape": "scalar",
                    "kind": "u64"
                  },
                  "value": "1"
                }
              }
            }
          },
          "writes": {
            "remaining": {
              "literal": {
                "type": {
                  "version": 1,
                  "shape": "scalar",
                  "kind": "u64"
                },
                "value": "0"
              }
            },
            "latched": {
              "literal": {
                "type": {
                  "version": 1,
                  "shape": "scalar",
                  "kind": "bool"
                },
                "value": false
              }
            }
          }
        }
      ],
      "outputs": {
        "emit": {
          "binary": {
            "op": "and",
            "left": {
              "input": "fired.expire"
            },
            "right": {
              "binary": {
                "op": "or",
                "left": {
                  "input": "state.latched"
                },
                "right": {
                  "input": "input.rsi_ok"
                }
              }
            }
          }
        },
        "remaining": {
          "input": "state.remaining"
        },
        "latched": {
          "input": "state.latched"
        },
        "armed": {
          "input": "fired.arm"
        },
        "expired": {
          "input": "fired.expire"
        }
      }
    }
