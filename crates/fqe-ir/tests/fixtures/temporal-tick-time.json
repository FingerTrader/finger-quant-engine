{
  "format": "fqe.temporal-rules",
  "schema_version": 1,
  "id": "independent.temporal-window",
  "version": "1",
  "requirements": [
    "temporal.windows/1"
  ],
  "windows": [
    {
      "id": "wait",
      "arm": {
        "instance": "fast",
        "output": "entry"
      },
      "predicate": {
        "event": "decision"
      },
      "span": {
        "kind": "event-time",
        "duration_ns": "3000"
      }
    }
  ]
}
