          "writes": {}
        },
        {
          "id": "release",
          "from": [
            "armed"
          ],
          "to": "idle",
          "guard": {
            "binary": {
              "op": "less_equal",
              "left": {
                "input": "input.sample"
              },
              "right": {
                "parameter": "threshold"
              }
            }
          },
          "writes": {}
        }
